#!/bin/sh
# A fake GitHub CLI for Anveg Code's manual and smoke tests. It answers the
# commands the app runs with fixed JSON; `FAKE_GH_LOG` (if set) records
# every call, so tests can check that nothing runs while views are hidden.
[ -n "$FAKE_GH_LOG" ] && echo "$(date +%s) $*" >> "$FAKE_GH_LOG"
case "$1 $2" in
  "--version "*) echo "gh version 2.63.0 (2024-11-27)"; exit 0 ;;
  "auth status") echo "Logged in to github.com account demo"; exit 0 ;;
  "repo view") echo '{"nameWithOwner":"demo/repo","url":"https://github.com/demo/repo","defaultBranchRef":{"name":"main"}}'; exit 0 ;;
  "pr list") cat <<'J'
[{"number":42,"title":"Add the greeting","author":{"login":"alice"},"headRefName":"greeting","isDraft":false,"reviewDecision":"APPROVED","statusCheckRollup":[{"__typename":"CheckRun","name":"test","status":"COMPLETED","conclusion":"FAILURE"}],"updatedAt":"2026-11-20T10:00:00Z"},
 {"number":43,"title":"Draft: refactor helper","author":{"login":"bob"},"headRefName":"refactor","isDraft":true,"reviewDecision":"REVIEW_REQUIRED","statusCheckRollup":[{"__typename":"CheckRun","name":"test","status":"IN_PROGRESS","conclusion":""}],"updatedAt":"2026-11-21T10:00:00Z"}]
J
    exit 0 ;;
  "pr view") cat <<'J'
{"number":42,"title":"Add the greeting","author":{"login":"alice"},"body":"This adds a **greeting**.\n\n- prints hello\n- adds a helper","baseRefName":"main","headRefName":"greeting","isDraft":false,"state":"OPEN","reviewDecision":"APPROVED","url":"https://github.com/demo/repo/pull/42","reviews":[{"author":{"login":"carol"},"state":"APPROVED","body":"Looks good"}],"comments":[{"author":{"login":"dave"},"body":"Nice work!"}],"statusCheckRollup":[],"additions":3,"deletions":1,"changedFiles":1}
J
    exit 0 ;;
  "pr checks") echo '[{"name":"test","state":"FAILURE","bucket":"fail","link":"https://github.com/demo/repo/actions/runs/777/job/1","workflow":"CI","description":""},{"name":"lint","state":"SUCCESS","bucket":"pass","link":"https://github.com/demo/repo/actions/runs/777/job/2","workflow":"CI","description":""}]'; exit 1 ;;
  "pr diff") cat <<'J'
diff --git a/src/main.rs b/src/main.rs
index 1111111..2222222 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -1,4 +1,5 @@
 fn main() {
-    let greeting = "hello";
+    let greeting = "hello, world";
+    let extra = 1;
     println!("{greeting}");
 }
J
    exit 0 ;;
  "run list") echo '[{"databaseId":777,"displayTitle":"Add the greeting","status":"completed","conclusion":"failure","workflowName":"CI","event":"push","headBranch":"main","createdAt":"2026-11-20T10:00:00Z","url":"https://github.com/demo/repo/actions/runs/777"},{"databaseId":776,"displayTitle":"Initial commit","status":"completed","conclusion":"success","workflowName":"CI","event":"push","headBranch":"main","url":"https://github.com/demo/repo/actions/runs/776"}]'; exit 0 ;;
  "run view")
    if [ "$4" = "--log-failed" ]; then printf 'test\tRun cargo test\tthread main panicked at src/main.rs:3:5\ntest\tRun cargo test\terror: test failed\n'; exit 0; fi
    echo '{"databaseId":777,"displayTitle":"Add the greeting","status":"completed","conclusion":"failure","workflowName":"CI","headBranch":"main","url":"https://github.com/demo/repo/actions/runs/777","jobs":[{"databaseId":1,"name":"test","status":"completed","conclusion":"failure"},{"databaseId":2,"name":"lint","status":"completed","conclusion":"success"}]}'
    exit 0 ;;
  "run rerun") exit 0 ;;
  "pr checkout"|"pr ready"|"pr merge"|"pr close") echo "done: $*"; exit 0 ;;
  "pr create") echo "https://github.com/demo/repo/pull/44"; exit 0 ;;
esac
echo "fake gh: unknown command: $*" >&2
exit 1
