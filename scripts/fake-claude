#!/usr/bin/env bash
# A stand-in for `claude` for tests and UI checks (build plan, section 10).
# No network, no model calls.
#
#   fake-claude --version | auth status | agents --json
#   fake-claude [--session-id ID] [--resume ID [--fork-session]] [--name N] [-- PROMPT]
#               [--worktree W] [--add-dir D]... [--settings F] [other flags]
#
# It prints its arguments, writes a JSONL transcript under
# $CLAUDE_CONFIG_DIR/projects/<encoded cwd>/<id>.jsonl, echoes each input
# line, records `/rename x` as a custom-title entry, and exits on `/exit`.
# When `--settings` names a hooks file and $ANVEG_HOOK_SOCKET is set, it
# runs that file's first hook command for SessionStart, UserPromptSubmit,
# Stop and SessionEnd (needs python3 to read the JSON; skipped otherwise).
# When that file also has a statusLine command, it runs it after each reply
# with a status-line JSON: each prompt adds 30k tokens of context (of 200k),
# `/compact` brings it back to 10k, `/effort X` sets the effort.
# The status line also carries plan limits (unless $FAKE_CLAUDE_API_KEY is
# set): each prompt adds 7% to the 5-hour window (from 30%) and 2% to the
# weekly one (from 55%), and 42 cents to the cost. `/limit` uses the
# 5-hour window up and ends the turn with a `StopFailure` (`rate_limit`).
set -u

CONFIG_DIR=${CLAUDE_CONFIG_DIR:-$HOME/.claude}

case "${1:-}" in
  --version) echo "0.0.0-fake (Claude Code)"; exit 0 ;;
  auth) printf '{"loggedIn": true, "configDirectory": "%s"}\n' "$CONFIG_DIR"; exit 0 ;;
  agents) echo "[]"; exit 0 ;;
esac

session_id=""
resume_id=""
fork=0
name=""
worktree=""
settings=""
args=("$@")
while [ $# -gt 0 ]; do
  case "$1" in
    --session-id) session_id=$2; shift 2 ;;
    --resume|-r) resume_id=$2; shift 2 ;;
    --fork-session) fork=1; shift ;;
    --name|-n) name=$2; shift 2 ;;
    --worktree|-w) worktree=$2; shift 2 ;;
    --settings) settings=$2; shift 2 ;;
    --add-dir) shift 2 ;;
    --) shift; initial=$*; break ;;
    *) shift ;;
  esac
done

if [ -z "$session_id" ]; then
  if [ -n "$resume_id" ] && [ "$fork" = 0 ]; then
    session_id=$resume_id
  else
    session_id=$(uuidgen 2>/dev/null | tr 'A-Z' 'a-z' || cat /proc/sys/kernel/random/uuid)
  fi
fi

if [ -n "$worktree" ]; then
  mkdir -p ".claude/worktrees/$worktree" && cd ".claude/worktrees/$worktree" || exit 1
fi

encoded=$(printf '%s' "$PWD" | sed 's/[^A-Za-z0-9]/-/g')
dir="$CONFIG_DIR/projects/$encoded"
file="$dir/$session_id.jsonl"
mkdir -p "$dir"

json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
now() { date -u +%Y-%m-%dT%H:%M:%S.000Z; }

hook() { # event [extra json fields]
  [ -n "$settings" ] && [ -n "${ANVEG_HOOK_SOCKET:-}" ] && [ -f "$settings" ] || return 0
  command -v python3 >/dev/null || return 0
  local cmd
  cmd=$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["hooks"][sys.argv[2]][0]["hooks"][0]["command"])' "$settings" "$1" 2>/dev/null) || return 0
  printf '{"session_id":"%s","hook_event_name":"%s","cwd":"%s"%s}' "$session_id" "$1" "$(json_escape "$PWD")" "${2:-}" | sh -c "$cmd" >/dev/null 2>&1
}

echo "fake-claude: session $session_id"
echo "fake-claude: args: ${args[*]:-}"
echo "fake-claude: transcript $file"
if [ -n "$name" ]; then
  printf '{"type":"custom-title","customTitle":"%s","sessionId":"%s"}\n' "$(json_escape "$name")" "$session_id" >> "$file"
fi
context=0
effort=high
five=30
week=55
cents=0
start=$(date +%s)
five_reset=$((start + 2 * 3600 + 14 * 60))
week_reset=$((start + 4 * 86400 + 3 * 3600))
rate_limits() {
  [ -n "${FAKE_CLAUDE_API_KEY:-}" ] && return 0
  printf ',"rate_limits":{"five_hour":{"used_percentage":%d,"resets_at":%d},"seven_day":{"used_percentage":%d,"resets_at":%d}}' \
    "$five" "$five_reset" "$week" "$week_reset"
}
status_line() {
  [ -n "$settings" ] && [ -f "$settings" ] || return 0
  command -v python3 >/dev/null || return 0
  local cmd
  cmd=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["statusLine"]["command"])' "$settings" 2>/dev/null) || return 0
  printf '{"session_id":"%s","model":{"id":"claude-fake-1","display_name":"Fake 1"},"effort":{"level":"%s"},"context_window":{"total_input_tokens":%d,"context_window_size":200000,"used_percentage":%d,"remaining_percentage":%d,"current_usage":{"input_tokens":%d,"cache_creation_input_tokens":0,"cache_read_input_tokens":0}},"cost":{"total_cost_usd":%d.%02d}%s}' \
    "$session_id" "$effort" "$context" $((context * 100 / 200000)) $((100 - context * 100 / 200000)) "$context" \
    $((cents / 100)) $((cents % 100)) "$(rate_limits)" | sh -c "$cmd" >/dev/null 2>&1
}

hook SessionStart ',"source":"startup"'
status_line
trap 'hook SessionEnd ",\"reason\":\"other\""; exit 0' HUP TERM

handle() {
  local line=$1
  case "$line" in
    /exit) hook SessionEnd ',"reason":"prompt_input_exit"'; echo "bye"; exit 0 ;;
    /rename\ *)
      title=${line#/rename }
      printf '{"type":"custom-title","customTitle":"%s","sessionId":"%s"}\n' "$(json_escape "$title")" "$session_id" >> "$file"
      echo "Session renamed to: $title" ;;
    "") ;;
    /compact)
      context=10000; echo "Compacted."; status_line ;;
    /effort\ *)
      effort=${line#/effort }; echo "Effort set to $effort"; status_line ;;
    /limit)
      hook UserPromptSubmit
      five=100
      echo "You've hit your session limit"
      hook StopFailure ',"error":"rate_limit","error_details":"429"'
      status_line ;;
    *)
      hook UserPromptSubmit
      printf '{"type":"user","message":{"role":"user","content":"%s"},"timestamp":"%s","cwd":"%s","sessionId":"%s","entrypoint":"cli","isSidechain":false}\n' \
        "$(json_escape "$line")" "$(now)" "$(json_escape "$PWD")" "$session_id" >> "$file"
      echo "echo: $line"
      context=$((context + 30000)); [ "$context" -gt 200000 ] && context=200000
      five=$((five + 7)); [ "$five" -gt 100 ] && five=100
      week=$((week + 2)); [ "$week" -gt 100 ] && week=100
      cents=$((cents + 42))
      hook Stop
      status_line ;;
  esac
}

# `claude -- <prompt>`: the first message, sent at once (newlines folded).
if [ -n "${initial:-}" ]; then
  handle "$(printf '%s' "$initial" | tr '\n' ' ')"
fi

printf '> '
while IFS= read -r line; do
  line=${line%$'\r'}
  handle "$line"
  printf '> '
done
hook SessionEnd ',"reason":"other"'
